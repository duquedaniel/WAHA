# Portainer (produção) > Stacks > waha > Environment variables
# Generate secrets with: openssl rand -hex 32  (NEW values, never reuse demo secrets)

# Pin by digest: docker pull devlikeapro/waha:gows && docker inspect --format '{{index .RepoDigests 0}}' devlikeapro/waha:gows
WAHA_IMAGE=devlikeapro/waha@sha256:REPLACE_ME

# Host loopback port for the SSH tunnel (osteogest uses 127.0.0.1:3001)
WAHA_ADMIN_PORT=3002

WAHA_CONTAINER_NAME=waha
WAHA_NETWORK=waha_net

# Master key hashed: KEY=$(openssl rand -hex 32); echo -n "$KEY" | sha512sum
# Value: sha512:<hash>. Keep $KEY offline (password manager); the Dashboard asks for it.
WAHA_API_KEY=sha512:REPLACE_ME
WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

WAHA_MEM_LIMIT=1g
WAHA_CPUS=1.0
