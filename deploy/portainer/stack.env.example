# Copy these into Portainer > Stacks > waha > Environment variables
# Generate secrets with: openssl rand -hex 32

# Server LAN IP (demo: 192.168.200.6). WAHA is published only on this IP.
WAHA_LAN_IP=192.168.200.6
# Host port for LAN access (3000 is taken by Grafana on the demo server). Containers always use waha:3000.
WAHA_LAN_PORT=3002

# gows | noweb | latest (WEBJS/Chromium) | gows-arm | noweb-arm | arm
WAHA_IMAGE_TAG=gows

# Change only when running more than one WAHA on the same server
WAHA_CONTAINER_NAME=waha
WAHA_NETWORK=waha_net

# Admin (master) key - used only to provision clinics, never shared with Osteogest
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
