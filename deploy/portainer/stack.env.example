# Copy these into Portainer > Stacks > waha > Environment variables
# Generate secrets with: openssl rand -hex 32

# Server LAN IP (demo: 192.168.200.6). WAHA is published only on this IP.
WAHA_LAN_IP=192.168.200.6
WAHA_LAN_PORT=3000

# gows | noweb | latest (WEBJS/Chromium) | gows-arm | noweb-arm | arm
WAHA_IMAGE_TAG=gows

WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WAHA_HOOK_HMAC_KEY=

# Osteogest webhook endpoint reachable through the shared "waha_net" network
OSTEOGEST_WEBHOOK_URL=http://osteogest:3000/api/webhooks/waha
